# Copie ce fichier en "db.properties" (à la racine du projet) puis adapte les valeurs.
# db.properties est ignoré par Git : ne le commite jamais.
# Les variables d'environnement MENTORUADB_DB_URL / MENTORUADB_DB_USER / MENTORUADB_DB_PASSWORD
# ont priorité sur ce fichier.
db.url=jdbc:mysql://localhost:3306/mentoruadb?useSSL=false&serverTimezone=UTC
db.user=root
db.password=
# Base référentielle universitaire (lecture seule).
# Variables d'environnement prioritaires : MENTORUADB_REF_URL / MENTORUADB_REF_USER / MENTORUADB_REF_PASSWORD
ref.url=jdbc:mysql://localhost:3306/referentiel_uadb?useSSL=false&serverTimezone=UTC
ref.user=root
ref.password=
