<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="racine" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uadb.mentoruadb.controller.BienvenueController"
      styleClass="acc-accueil-racine">
  <children>
    <!-- Barre latérale (grande fenêtre) -->
    <VBox fx:id="sidebar" styleClass="acc-sidebar" prefWidth="215.0" minWidth="215.0" maxWidth="215.0">
      <padding>
        <Insets top="26.0" right="16.0" bottom="20.0" left="16.0"/>
      </padding>
      <children>
        <VBox alignment="CENTER" spacing="2.0">
          <children>
            <ImageView fitHeight="70.0" preserveRatio="true">
              <image>
                <Image url="@../images/logo-uadb.png"/>
              </image>
            </ImageView>
            <Label text="UADB" styleClass="acc-logo-titre"/>
            <Label text="Université Alioune Diop de Bambey" wrapText="true"
                                           textAlignment="CENTER" styleClass="acc-logo-sous" />
          </children>
        </VBox>
        <Region prefHeight="22.0"/>
        <Label text="MentorUADB" styleClass="acc-marque-side"/>
        <Label text="Ensemble pour votre réussite" wrapText="true" styleClass="acc-marque-sous"/>
        <Region prefHeight="22.0"/>
        <Button fx:id="menuAccueilButton" text="🏠  Accueil" maxWidth="Infinity"
                                onAction="#onMenuAccueilClick" styleClass="acc-menu,acc-menu-actif" />
        <Button fx:id="menuConnexionButton" text="👤  Se connecter" maxWidth="Infinity"
                                onAction="#onMenuConnexionClick" styleClass="acc-menu" />
        <Button fx:id="menuAProposButton" text="ℹ  À propos" maxWidth="Infinity"
                                onAction="#onMenuAProposClick" styleClass="acc-menu" />
        <Button fx:id="menuAideButton" text="❓  Aide" maxWidth="Infinity"
                                onAction="#onMenuAideClick" styleClass="acc-menu" />
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="« S'orienter aujourd'hui, réussir demain »" wrapText="true"
                               textAlignment="CENTER" styleClass="acc-citation-bas" />
        <Region prefHeight="14.0"/>
        <Label text="UADB - Bambey" styleClass="acc-pilule-sombre" maxWidth="Infinity" alignment="CENTER"/>
      </children>
    </VBox>
    <!-- Zone principale -->
    <VBox HBox.hgrow="ALWAYS" styleClass="acc-principal">
      <children>
        <!-- Barre compacte (petite fenêtre, remplace la barre latérale) -->
        <HBox fx:id="barreCompacte" alignment="CENTER_LEFT" spacing="6.0"
                              styleClass="acc-barre-compacte" visible="false" managed="false">
          <children>
            <ImageView fitHeight="30.0" preserveRatio="true">
              <image>
                <Image url="@../images/logo-uadb.png"/>
              </image>
            </ImageView>
            <Label text="MentorUADB" styleClass="acc-marque-side" wrapText="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠" onAction="#onMenuAccueilClick" styleClass="acc-menu-compact,acc-menu-actif">
              <tooltip>
                <Tooltip text="Accueil"/>
              </tooltip>
            </Button>
            <Button text="👤" onAction="#onMenuConnexionClick" styleClass="acc-menu-compact">
              <tooltip>
                <Tooltip text="Se connecter"/>
              </tooltip>
            </Button>
            <Button text="ℹ" onAction="#onMenuAProposClick" styleClass="acc-menu-compact">
              <tooltip>
                <Tooltip text="À propos"/>
              </tooltip>
            </Button>
            <Button text="❓" onAction="#onMenuAideClick" styleClass="acc-menu-compact">
              <tooltip>
                <Tooltip text="Aide"/>
              </tooltip>
            </Button>
          </children>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="acc-scroll">
          <content>
            <VBox spacing="22.0" styleClass="acc-contenu">
              <padding>
                <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
              </padding>
              <children>
                <!-- Bannière d'accueil -->
                <HBox styleClass="acc-hero" alignment="CENTER_LEFT" spacing="20.0">
                  <children>
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label text="Bienvenue sur" styleClass="acc-hero-h1"/>
                        <Label text="MentorUADB" styleClass="acc-hero-marque"/>
                        <Label text="La plateforme de mentorat qui rapproche les étudiants de l'Université Alioune Diop de Bambey avec des mentors qualifiés."
                                                                               wrapText="true" styleClass="acc-hero-texte" />
                        <Label text="Échanger • Apprendre • Réussir" styleClass="acc-pilule"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                          <children>
                            <Button fx:id="connexionHeroButton" text="Se connecter"
                                                                                            maxWidth="-Infinity" onAction="#onConnexionClick"
                                                                                            styleClass="acc-bouton-hero" />
                            <Button fx:id="inscriptionHeroButton" text="Créer un compte"
                                                                                            maxWidth="-Infinity" onAction="#onInscriptionClick"
                                                                                            styleClass="acc-bouton-hero-secondaire" />
                          </children>
                        </HBox>
                      </children>
                    </VBox>
                    <ImageView fx:id="imageHero" fitWidth="220.0" preserveRatio="true" smooth="true"
                                                                       styleClass="acc-hero-image">
                      <image>
                        <Image url="@../images/etudiants-bibliotheque.jpg"/>
                      </image>
                    </ImageView>
                  </children>
                </HBox>
                <!-- Pourquoi MentorUADB : cartes de largeur fixe, qui passent à la ligne si besoin -->
                <Label text="Pourquoi MentorUADB ?" styleClass="acc-section-titre"/>
                <FlowPane hgap="14.0" vgap="14.0">
                  <children>
                    <VBox fx:id="carte1" alignment="TOP_CENTER" spacing="6.0"
                                                                  prefWidth="240.0" minWidth="200.0" maxWidth="240.0"
                                                                  styleClass="acc-carte">
                      <children>
                        <Label text="🎓" styleClass="acc-carte-icone"/>
                        <Label text="Accompagnement personnalisé" wrapText="true"
                                                                               textAlignment="CENTER" styleClass="acc-carte-titre" />
                        <Label text="Bénéficiez des conseils de mentors expérimentés dans votre domaine."
                                                                               wrapText="true" textAlignment="CENTER" styleClass="acc-carte-texte" />
                      </children>
                    </VBox>
                    <VBox fx:id="carte2" alignment="TOP_CENTER" spacing="6.0"
                                                                  prefWidth="240.0" minWidth="200.0" maxWidth="240.0"
                                                                  styleClass="acc-carte">
                      <children>
                        <Label text="👥" styleClass="acc-carte-icone"/>
                        <Label text="Mise en relation facile" wrapText="true"
                                                                               textAlignment="CENTER" styleClass="acc-carte-titre" />
                        <Label text="Trouvez rapidement le mentor qui correspond à vos besoins."
                                                                               wrapText="true" textAlignment="CENTER" styleClass="acc-carte-texte" />
                      </children>
                    </VBox>
                    <VBox fx:id="carte3" alignment="TOP_CENTER" spacing="6.0"
                                                                  prefWidth="240.0" minWidth="200.0" maxWidth="240.0"
                                                                  styleClass="acc-carte">
                      <children>
                        <Label text="📈" styleClass="acc-carte-icone"/>
                        <Label text="Développement de vos compétences" wrapText="true"
                                                                               textAlignment="CENTER" styleClass="acc-carte-titre" />
                        <Label text="Progressez grâce à des échanges enrichissants et des séances de suivi."
                                                                               wrapText="true" textAlignment="CENTER" styleClass="acc-carte-texte" />
                      </children>
                    </VBox>
                    <VBox fx:id="carte4" alignment="TOP_CENTER" spacing="6.0"
                                                                  prefWidth="240.0" minWidth="200.0" maxWidth="240.0"
                                                                  styleClass="acc-carte">
                      <children>
                        <Label text="✔" styleClass="acc-carte-icone"/>
                        <Label text="Un cadre sécurisé" wrapText="true"
                                                                               textAlignment="CENTER" styleClass="acc-carte-titre" />
                        <Label text="Une plateforme fiable, réservée aux membres de l'UADB."
                                                                               wrapText="true" textAlignment="CENTER" styleClass="acc-carte-texte" />
                      </children>
                    </VBox>
                  </children>
                </FlowPane>
                <!-- Citation -->
                <VBox spacing="4.0" styleClass="acc-citation">
                  <children>
                    <Label text="“" styleClass="acc-citation-guillemet"/>
                    <Label text="Le mentorat est un pont entre vos ambitions et votre avenir."
                                                                   wrapText="true" styleClass="acc-citation-texte" />
                    <Label text="— MentorUADB" styleClass="acc-citation-auteur"/>
                  </children>
                </VBox>
              </children>
            </VBox>
          </content>
        </ScrollPane>
        <!-- Pied de page -->
        <HBox alignment="CENTER_LEFT" styleClass="acc-pied-page">
          <children>
            <Label text="🎓 Université Alioune Diop de Bambey" styleClass="acc-pied-texte" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="MentorUADB v1.0 | UADB © 2026" styleClass="acc-pied-texte" wrapText="true"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</HBox>
