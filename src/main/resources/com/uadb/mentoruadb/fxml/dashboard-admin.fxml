<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.DashboardAdminController"
            styleClass="racine">

    <fx:define>
        <ToggleGroup fx:id="menuGroup" />
    </fx:define>

    <!-- Barre du haut -->
    <top>
        <HBox styleClass="topbar">
            <Label text="MentorUADB" styleClass="topbar-titre" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Université Alioune Diop de Bambey" styleClass="topbar-info" />
        </HBox>
    </top>

    <!-- Barre latérale -->
    <left>
        <VBox styleClass="sidebar" prefWidth="215.0" minWidth="215.0" spacing="3.0">
            <Label text="ADMINISTRATION" styleClass="sidebar-section" />

            <ToggleButton text="Accueil" toggleGroup="$menuGroup" selected="true"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secAccueil" /></userData>
            </ToggleButton>
            <ToggleButton text="Validation des mentors" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secValidation" /></userData>
            </ToggleButton>
            <ToggleButton text="Liste des mentors" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secListeMentors" /></userData>
            </ToggleButton>
            <ToggleButton text="Utilisateurs" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secUtilisateurs" /></userData>
            </ToggleButton>
            <ToggleButton text="UFR / Filières / Matières" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secDonnees" /></userData>
            </ToggleButton>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="deconnexionButton" text="Déconnexion" onAction="#onDeconnexionClick"
                    styleClass="deconnexion-button" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Contenu : les écrans existants, intégrés tels quels -->
    <center>
        <VBox spacing="8.0">
            <padding>
                <Insets top="16.0" right="20.0" bottom="12.0" left="20.0" />
            </padding>

            <Label fx:id="bienvenueLabel" styleClass="title-label" wrapText="true" />

            <StackPane fx:id="sectionsPane" VBox.vgrow="ALWAYS">
                <!-- Accueil -->
                <ScrollPane fx:id="secAccueil" fitToWidth="true">
                    <VBox spacing="16.0" styleClass="contenu-page">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

                        <HBox spacing="12.0">
                            <VBox styleClass="stat-carte" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                                <Label fx:id="statEtudiants" text="0" styleClass="stat-valeur" />
                                <Label text="Comptes étudiants" styleClass="stat-libelle" wrapText="true" />
                            </VBox>
                            <VBox styleClass="stat-carte" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                                <Label fx:id="statMentors" text="0" styleClass="stat-valeur" />
                                <Label text="Mentors validés" styleClass="stat-libelle" wrapText="true" />
                            </VBox>
                            <VBox styleClass="stat-carte" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                                <Label fx:id="statCandidatures" text="0" styleClass="stat-valeur" />
                                <Label text="Candidatures en attente" styleClass="stat-libelle" wrapText="true" />
                            </VBox>
                            <VBox styleClass="stat-carte" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                                <Label fx:id="statSeancesAVenir" text="0" styleClass="stat-valeur" />
                                <Label text="Séances à venir" styleClass="stat-libelle" wrapText="true" />
                            </VBox>
                        </HBox>

                        <VBox styleClass="carte" spacing="10.0">
                            <Label text="Demandes de mentorat" styleClass="subtitle-label" />
                            <VBox fx:id="demandesBox" spacing="8.0" />
                        </VBox>

                        <VBox styleClass="carte" spacing="10.0">
                            <Label text="Séances" styleClass="subtitle-label" />
                            <VBox fx:id="seancesBox" spacing="8.0" />
                        </VBox>
                    </VBox>
                </ScrollPane>

                <StackPane fx:id="secValidation" visible="false" managed="false">
                    <fx:include source="validation-mentors.fxml" />
                </StackPane>
                <StackPane fx:id="secListeMentors" visible="false" managed="false">
                    <fx:include source="liste-mentors.fxml" />
                </StackPane>
                <StackPane fx:id="secUtilisateurs" visible="false" managed="false">
                    <fx:include source="gestion-utilisateurs.fxml" />
                </StackPane>
                <StackPane fx:id="secDonnees" visible="false" managed="false">
                    <fx:include source="gestion-donnees.fxml" />
                </StackPane>
            </StackPane>

            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />
        </VBox>
    </center>
</BorderPane>