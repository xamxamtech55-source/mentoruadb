<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uadb.mentoruadb.controller.DashboardAdminController">
    <VBox spacing="14.0" prefWidth="540.0" maxWidth="540.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="34.0" right="34.0" bottom="34.0" left="34.0" />
        </padding>

        <HBox spacing="12.0" alignment="CENTER">
            <Label fx:id="bienvenueLabel" styleClass="title-label" wrapText="true" maxWidth="330.0" />
            <Button fx:id="deconnexionButton" text="Déconnexion" onAction="#onDeconnexionClick" styleClass="deconnexion-button" />
        </HBox>

        <Label text="Administration" styleClass="subtitle-label" alignment="CENTER" maxWidth="Infinity" />

        <VBox spacing="12.0" alignment="CENTER" fillWidth="false">
            <Button text="Valider les candidats mentor" onAction="#onValiderMentorsClick" styleClass="admin-menu-button" />
            <Button text="Liste des mentors" onAction="#onListeMentorsClick" styleClass="admin-menu-button" />
            <Button text="Gestion des utilisateurs" onAction="#onGestionUtilisateursClick" styleClass="admin-menu-button" />
            <Button text="Gestion UFR / Filières / Niveaux / Matières" onAction="#onGestionDonneesClick" styleClass="admin-menu-button" />
        </VBox>

        <Label fx:id="messageLabel" styleClass="message-label" alignment="CENTER" wrapText="true" textAlignment="CENTER" maxWidth="Infinity" />
    </VBox>
</VBox>
