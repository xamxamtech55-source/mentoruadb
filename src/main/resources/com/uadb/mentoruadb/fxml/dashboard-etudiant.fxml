<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.DashboardEtudiantController"
            styleClass="racine">

    <fx:define>
        <ToggleGroup fx:id="menuGroup" />
    </fx:define>

    <!-- Barre du haut -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT"><Button fx:id="hamburgerButton" text="☰" onAction="#onHamburgerClick" styleClass="hamburger-button" />
            <Label text="MentorUADB" styleClass="topbar-titre" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="etudiantHeaderLabel" styleClass="topbar-info" />
            <Label text="   ·   " styleClass="topbar-info" />
            <Label text="Université Alioune Diop de Bambey" styleClass="topbar-info" />
        </HBox>
    </top>

    <!-- Barre latérale -->
    <left>
        <VBox fx:id="sidebarPane" styleClass="sidebar" prefWidth="215.0" minWidth="215.0" spacing="3.0">
            <Label text="ESPACE ÉTUDIANT" styleClass="sidebar-section" />

            <ToggleButton text="Mes demandes" toggleGroup="$menuGroup" selected="true"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secDemandes" /></userData>
            </ToggleButton>
            <ToggleButton text="Mes séances" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secSeances" /></userData>
            </ToggleButton>
            <ToggleButton text="Évaluations" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secEvaluations" /></userData>
            </ToggleButton>
            <ToggleButton text="Ressources" toggleGroup="$menuGroup"
                          onAction="#onMenuClick" styleClass="menu-item" maxWidth="Infinity">
                <userData><String fx:value="secRessources" /></userData>
            </ToggleButton>

            <Label text="COMPTE" styleClass="sidebar-section" />

            <Button fx:id="profilButton" text="Mon profil" onAction="#onProfilClick"
                    styleClass="menu-item" maxWidth="Infinity" />
            <Button fx:id="devenirMentorButton" text="Devenir mentor" onAction="#onDevenirMentorClick"
                    styleClass="menu-item" maxWidth="Infinity" />
            <Button fx:id="tableauMentorButton" text="Espace mentor" onAction="#onTableauMentorClick"
                    styleClass="menu-item" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="deconnexionButton" text="Déconnexion" onAction="#onDeconnexionClick"
                    styleClass="deconnexion-button" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Contenu -->
    <center>
        <ScrollPane fx:id="scrollContenu" fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
        <VBox spacing="10.0">
            <padding>
                <Insets top="14.0" right="20.0" bottom="12.0" left="20.0" />
            </padding>

            <Label fx:id="bienvenueLabel" text="Mon tableau de bord" styleClass="title-label" wrapText="true" />

            <Button fx:id="notificationButton" styleClass="notification-label" wrapText="true" visible="false" managed="false"
                    onAction="#onNotificationClick" maxWidth="Infinity" alignment="BASELINE_LEFT" />
            <Button fx:id="notificationsGeneriquesButton" styleClass="notification-label" wrapText="true" visible="false" managed="false"
                    onAction="#onNotificationsGeneriquesClick" maxWidth="Infinity" alignment="BASELINE_LEFT" />

            <!-- Zone de synthèse : demandes, séances, ressources -->
            <HBox spacing="12.0">
                <VBox styleClass="ds-stat-card,ds-stat-card-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                    <Label fx:id="statDemandesValue" text="0" styleClass="ds-stat-value" />
                    <Label text="Demandes de mentorat" styleClass="ds-stat-label" wrapText="true" />
                    <Label fx:id="statDemandesDetail" styleClass="ds-stat-label" wrapText="true" />
                </VBox>
                <VBox styleClass="ds-stat-card,ds-stat-card-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                    <Label fx:id="statDemandesSeanceValue" text="0" styleClass="ds-stat-value" />
                    <Label text="Demandes de séance" styleClass="ds-stat-label" wrapText="true" />
                    <Label fx:id="statDemandesSeanceDetail" styleClass="ds-stat-label" wrapText="true" />
                </VBox>
                <VBox styleClass="ds-stat-card,ds-stat-card-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                    <Label fx:id="statSeancesValue" text="0" styleClass="ds-stat-value" />
                    <Label text="Séances" styleClass="ds-stat-label" wrapText="true" />
                    <Label fx:id="statSeancesDetail" styleClass="ds-stat-label" wrapText="true" />
                </VBox>
                <VBox styleClass="ds-stat-card,ds-stat-card-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
                    <Label fx:id="statRessourcesValue" text="0" styleClass="ds-stat-value" />
                    <Label text="Ressources" styleClass="ds-stat-label" wrapText="true" />
                    <Label fx:id="statRessourcesDetail" styleClass="ds-stat-label" wrapText="true" />
                </VBox>
            </HBox>

            <!-- Raccourcis -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Trouver un mentor" onAction="#onRechercherMentorClick" styleClass="ds-btn,ds-btn-secondary" />
                <Button text="Mon profil" onAction="#onProfilClick" styleClass="ds-btn,ds-btn-secondary" />
                <Button fx:id="devenirMentorRaccourci" text="Devenir mentor" onAction="#onDevenirMentorClick" styleClass="ds-btn,ds-btn-secondary" />
            </HBox>

            <!-- Message de la rubrique active -->
            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />

            <StackPane fx:id="sectionsPane">

                <!-- Mes demandes -->
                <VBox fx:id="secDemandes">
                    <VBox spacing="10.0" styleClass="contenu-page">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

                        <Button fx:id="rechercherMentorButton" text="Rechercher un mentor" onAction="#onRechercherMentorClick" styleClass="ds-btn,ds-btn-secondary" />

                        <Label text="Mes demandes de mentorat" styleClass="subtitle-label" />
                        <TableView fx:id="demandesTable" prefHeight="150.0" minHeight="150.0">
                            <columns>
                                <TableColumn fx:id="colDemandeMentor" text="Mentor" prefWidth="150.0" />
                                <TableColumn fx:id="colDemandeMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colDemandeDate" text="Date demande" prefWidth="110.0" />
                                <TableColumn fx:id="colDemandeStatut" text="Statut" prefWidth="100.0" />
                            </columns>
                        </TableView>
                        <Button text="Effacer la demande sélectionnée" onAction="#onEffacerDemandeClick" styleClass="bouton-secondaire" />

                        <Label text="Demander une séance (sur une demande de mentorat ACCEPTEE, sélectionnée ci-dessus)" wrapText="true" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <DatePicker fx:id="dateSouhaiteePicker" promptText="Date souhaitée (facultatif)" />
                            <TextField fx:id="messageSeanceField" promptText="Message pour le mentor (facultatif)" HBox.hgrow="ALWAYS" />
                            <Button text="Demander une séance" onAction="#onDemanderSeanceClick" styleClass="ds-btn" />
                        </HBox>

                        <Label text="Mes demandes de séance" styleClass="subtitle-label" />
                        <TableView fx:id="demandeSeanceTable" prefHeight="150.0" minHeight="150.0">
                            <columns>
                                <TableColumn fx:id="colDsMentor" text="Mentor" prefWidth="140.0" />
                                <TableColumn fx:id="colDsMatiere" text="Matière" prefWidth="110.0" />
                                <TableColumn fx:id="colDsDateSouhaitee" text="Date souhaitée" prefWidth="110.0" />
                                <TableColumn fx:id="colDsStatut" text="Statut" prefWidth="100.0" />
                                <TableColumn fx:id="colDsDatePlanifiee" text="Date planifiée" prefWidth="110.0" />
                            </columns>
                        </TableView>
                        <Button text="Effacer la demande de séance" onAction="#onEffacerDemandeSeanceClick" styleClass="bouton-secondaire" />
                    </VBox>
                </VBox>

                <!-- Mes séances -->
                <VBox fx:id="secSeances" visible="false" managed="false">
                    <VBox spacing="10.0" styleClass="contenu-page">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

                        <Label text="Prochaines séances" styleClass="subtitle-label" />
                        <TableView fx:id="prochainesSeancesTable" prefHeight="130.0" minHeight="110.0">
                            <columns>
                                <TableColumn fx:id="colProchMentor" text="Mentor" prefWidth="150.0" />
                                <TableColumn fx:id="colProchMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colProchDate" text="Date" prefWidth="100.0" />
                                <TableColumn fx:id="colProchDebut" text="Début" prefWidth="80.0" />
                                <TableColumn fx:id="colProchFin" text="Fin" prefWidth="80.0" />
                                <TableColumn fx:id="colProchStatut" text="Statut" prefWidth="100.0" />
                            </columns>
                        </TableView>

                        <Label text="Séances de groupe à confirmer" styleClass="subtitle-label" />
                        <TableView fx:id="seancesAConfirmerTable" prefHeight="110.0" minHeight="110.0">
                            <columns>
                                <TableColumn fx:id="colConfirmMentor" text="Mentor" prefWidth="150.0" />
                                <TableColumn fx:id="colConfirmMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colConfirmDate" text="Date" prefWidth="100.0" />
                                <TableColumn fx:id="colConfirmHeure" text="Heure" prefWidth="100.0" />
                            </columns>
                        </TableView>
                        <Button text="Confirmer ma présence" onAction="#onConfirmerPresenceClick" styleClass="ds-btn" />

                        <Label text="Toutes mes séances" styleClass="subtitle-label" />
                        <TableView fx:id="seancesTable" prefHeight="170.0" minHeight="170.0">
                            <columns>
                                <TableColumn fx:id="colSeanceMentor" text="Mentor" prefWidth="150.0" />
                                <TableColumn fx:id="colSeanceMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colSeanceDate" text="Date" prefWidth="100.0" />
                                <TableColumn fx:id="colSeanceHeureDebut" text="Début" prefWidth="80.0" />
                                <TableColumn fx:id="colSeanceHeureFin" text="Fin" prefWidth="80.0" />
                                <TableColumn fx:id="colSeanceStatut" text="Statut" prefWidth="100.0" />
                            </columns>
                        </TableView>
                        <Button text="Effacer la séance sélectionnée" onAction="#onEffacerSeanceClick" styleClass="bouton-secondaire" />

                        <Label text="Évaluer une séance réalisée (sélectionne-la dans le tableau ci-dessus)" wrapText="true" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <ComboBox fx:id="noteComboBox" promptText="Note (1-5)" />
                            <TextField fx:id="commentaireField" promptText="Commentaire" HBox.hgrow="ALWAYS" />
                            <Button text="Évaluer" onAction="#onEvaluerClick" styleClass="ds-btn" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Évaluations -->
                <VBox fx:id="secEvaluations" visible="false" managed="false">
                    <VBox spacing="10.0" styleClass="contenu-page">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                        <Label text="Mes évaluations données" styleClass="subtitle-label" />
                        <TableView fx:id="evaluationsTable" prefHeight="330.0">
                            <columns>
                                <TableColumn fx:id="colEvalMentor" text="Mentor" prefWidth="150.0" />
                                <TableColumn fx:id="colEvalMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colEvalNote" text="Note" prefWidth="60.0" />
                                <TableColumn fx:id="colEvalCommentaire" text="Commentaire" prefWidth="220.0" />
                                <TableColumn fx:id="colEvalDate" text="Date" prefWidth="100.0" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- Ressources -->
                <VBox fx:id="secRessources" visible="false" managed="false">
                    <VBox spacing="10.0" styleClass="contenu-page">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                        <Label text="Fichiers partagés par mes mentors" styleClass="subtitle-label" />
                        <TableView fx:id="fichiersTable" prefHeight="330.0">
                            <columns>
                                <TableColumn fx:id="colFichierNom" text="Nom du fichier" prefWidth="220.0" />
                                <TableColumn fx:id="colFichierMatiere" text="Matière" prefWidth="120.0" />
                                <TableColumn fx:id="colFichierDate" text="Date" prefWidth="100.0" />
                            </columns>
                        </TableView>
                        <Button text="Ouvrir le fichier sélectionné" onAction="#onOuvrirFichierClick" styleClass="ds-btn" />
                    </VBox>
                </VBox>
            </StackPane>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
