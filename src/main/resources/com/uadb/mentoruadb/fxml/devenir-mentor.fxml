<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.DevenirMentorController">
    <VBox styleClass="contenu-page">
        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

        <VBox spacing="12.0" styleClass="page-carte">
            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0" /></padding>

            <!-- Page intégrée au tableau de bord : le retour se fait par la barre latérale -->
            <Button fx:id="retourButton" visible="false" managed="false" text="Retour" onAction="#onRetourClick" />

            <Label text="Devenir mentor" styleClass="title-label" />
            <Label text="Sélectionne les matières dans lesquelles tu peux accompagner d'autres étudiants (Ctrl+clic pour en choisir plusieurs)" wrapText="true" />

            <ListView fx:id="matieresListView" prefHeight="320.0" />

            <HBox spacing="10.0">
                <Button text="Envoyer ma candidature" onAction="#onCandidaterClick" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="message-label" />
        </VBox>
    </VBox>
</ScrollPane>