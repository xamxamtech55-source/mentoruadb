<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uadb.mentoruadb.controller.GestionDonneesController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="Gestion des données académiques" styleClass="title-label" />

    <TabPane VBox.vgrow="ALWAYS">
        <Tab text="UFR" closable="false">
            <VBox spacing="10.0">
                <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                <TableView fx:id="ufrTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUfrNom" text="Nom" prefWidth="300.0" />
                    </columns>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="ufrNomField" promptText="Nom de l'UFR" HBox.hgrow="ALWAYS" />
                    <Button text="Ajouter" onAction="#onAjouterUfrClick" />
                    <Button text="Supprimer" onAction="#onSupprimerUfrClick" styleClass="lien-button" />
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Filières" closable="false">
            <VBox spacing="10.0">
                <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                <TableView fx:id="filiereTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFiliereNom" text="Nom" prefWidth="200.0" />
                        <TableColumn fx:id="colFiliereUfr" text="UFR" prefWidth="200.0" />
                    </columns>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="filiereNomField" promptText="Nom de la filière" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="filiereUfrComboBox" promptText="UFR" />
                    <Button text="Ajouter" onAction="#onAjouterFiliereClick" />
                    <Button text="Supprimer" onAction="#onSupprimerFiliereClick" styleClass="lien-button" />
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Niveaux" closable="false">
            <VBox spacing="10.0">
                <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                <TableView fx:id="niveauTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNiveauLibelle" text="Libellé" prefWidth="300.0" />
                    </columns>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="niveauLibelleField" promptText="Libellé (ex: Licence 3)" HBox.hgrow="ALWAYS" />
                    <Button text="Ajouter" onAction="#onAjouterNiveauClick" />
                    <Button text="Supprimer" onAction="#onSupprimerNiveauClick" styleClass="lien-button" />
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Matières" closable="false">
            <VBox spacing="10.0">
                <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
                <TableView fx:id="matiereTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMatiereNom" text="Nom" prefWidth="300.0" />
                    </columns>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="matiereNomField" promptText="Nom de la matière" HBox.hgrow="ALWAYS" />
                    <Button text="Ajouter" onAction="#onAjouterMatiereClick" />
                    <Button text="Supprimer" onAction="#onSupprimerMatiereClick" styleClass="lien-button" />
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <HBox spacing="10.0">
        <Button fx:id="retourButton" text="Retour" onAction="#onRetourClick" styleClass="lien-button" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>