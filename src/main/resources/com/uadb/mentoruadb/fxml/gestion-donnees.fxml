<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.GestionDonneesController">
    <VBox spacing="15.0">
      <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
      </padding>
      <Label text="Gestion des données académiques" styleClass="title-label"/>
      <Label text="Les suppressions sont confirmées ; les données liées les bloquent."
             styleClass="subtitle-label" wrapText="true"/>
      <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>

      <!-- 1. Arbre UFR → filières → matières + formulaires -->
      <VBox styleClass="ds-card" spacing="10.0">
        <children>
          <Label text="1. Organisation — UFR, filières et matières rattachées" styleClass="ds-section-title"/>
          <HBox spacing="20.0">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Sélectionne une UFR ou une filière dans l'arbre" styleClass="ds-help"/>
                <TreeView fx:id="organisationTree" prefHeight="300.0" VBox.vgrow="ALWAYS"
                                                          minWidth="300.0" maxWidth="Infinity"/>
              </children>
            </VBox>
            <VBox spacing="10.0" prefWidth="340.0" minWidth="280.0" maxWidth="340.0">
              <children>
                <Label text="Ajouter une UFR" styleClass="subtitle-label"/>
                <HBox spacing="8.0">
                  <children>
                    <TextField fx:id="ufrNomField" promptText="Nom de l'UFR"
                                                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Ajouter" onAction="#onAjouterUfrClick"/>
                  </children>
                </HBox>
                <Label text="Ajouter une filière à l'UFR sélectionnée" styleClass="subtitle-label"/>
                <TextField fx:id="filiereNomField" promptText="Nom de la filière" maxWidth="Infinity"/>
                <Label text="Niveaux proposés (Ctrl+clic pour en choisir plusieurs)" wrapText="true" styleClass="ds-help"/>
                <ListView fx:id="niveauxListView" prefHeight="105.0" maxWidth="Infinity"/>
                <Button text="Ajouter la filière" onAction="#onAjouterFiliereClick" maxWidth="Infinity"/>
                <Label text="Matières de la filière sélectionnée" styleClass="subtitle-label"/>
                <HBox spacing="8.0">
                  <children>
                    <ComboBox fx:id="matiereRattacherComboBox" promptText="Matière du catalogue"
                                                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Rattacher" onAction="#onRattacherMatiereClick"/>
                  </children>
                </HBox>
                <Button text="Détacher la matière sélectionnée" onAction="#onDetacherMatiereClick"
                                                        maxWidth="Infinity"/>
                <Button text="Supprimer l'UFR / la filière sélectionnée"
                                                        onAction="#onSupprimerSelectionClick" styleClass="ds-btn,ds-btn-danger"/>
              </children>
            </VBox>
          </HBox>
        </children>
      </VBox>

      <!-- 2. Catalogue des matières -->
      <VBox styleClass="ds-card" spacing="10.0">
        <children>
          <Label text="2. Catalogue des matières" styleClass="ds-section-title"/>
          <TableView fx:id="matiereTable" prefHeight="220.0" maxWidth="Infinity">
            <columns>
              <TableColumn fx:id="colMatiereNom" text="Nom" prefWidth="320.0"/>
            </columns>
          </TableView>
          <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
              <TextField fx:id="matiereNomField" promptText="Nom de la nouvelle matière"
                                                         prefWidth="300.0" HBox.hgrow="ALWAYS"/>
              <Button text="Ajouter" onAction="#onAjouterMatiereClick"/>
              <Button text="Supprimer" onAction="#onSupprimerMatiereClick" styleClass="ds-btn,ds-btn-danger"/>
            </children>
          </HBox>
          <Label text="Pense à rattacher chaque nouvelle matière à une filière (section Organisation), sinon elle ne sera visible nulle part."
                                         wrapText="true" styleClass="ds-help"/>
        </children>
      </VBox>

      <!-- 3. Niveaux -->
      <VBox styleClass="ds-card" spacing="10.0">
        <children>
          <Label text="3. Niveaux" styleClass="ds-section-title"/>
          <TableView fx:id="niveauTable" prefHeight="180.0" maxWidth="Infinity">
            <columns>
              <TableColumn fx:id="colNiveauLibelle" text="Libellé" prefWidth="320.0"/>
            </columns>
          </TableView>
          <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
              <TextField fx:id="niveauLibelleField" promptText="Libellé (ex: Licence 3)"
                                                         prefWidth="300.0" HBox.hgrow="ALWAYS"/>
              <Button text="Ajouter" onAction="#onAjouterNiveauClick"/>
              <Button text="Supprimer" onAction="#onSupprimerNiveauClick" styleClass="ds-btn,ds-btn-danger"/>
            </children>
          </HBox>
        </children>
      </VBox>
    </VBox>
</VBox>
