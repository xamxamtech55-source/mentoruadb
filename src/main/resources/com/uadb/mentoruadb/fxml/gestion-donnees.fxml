<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.GestionDonneesController">
  <content>
    <VBox spacing="15.0">
      <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
      </padding>
      <Label text="Gestion des données académiques" styleClass="title-label"/>
      <TabPane VBox.vgrow="ALWAYS" minHeight="420.0">
        <!-- Onglet 1 : arbre UFR → filières → matières -->
        <Tab text="Organisation (UFR → Filières → Matières)" closable="false">
          <HBox spacing="20.0">
            <padding>
              <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Sélectionne une UFR ou une filière dans l'arbre"/>
                <TreeView fx:id="organisationTree" VBox.vgrow="ALWAYS"
                                                          minWidth="300.0" maxWidth="Infinity" />
              </children>
            </VBox>
            <VBox spacing="10.0" prefWidth="340.0" minWidth="300.0" maxWidth="340.0">
              <children>
                <Label text="Ajouter une UFR" styleClass="subtitle-label"/>
                <HBox spacing="8.0">
                  <children>
                    <TextField fx:id="ufrNomField" promptText="Nom de l'UFR"
                                                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button text="Ajouter" onAction="#onAjouterUfrClick"/>
                  </children>
                </HBox>
                <Label text="Ajouter une filière à l'UFR sélectionnée" styleClass="subtitle-label"/>
                <TextField fx:id="filiereNomField" promptText="Nom de la filière" maxWidth="Infinity"/>
                <Label text="Niveaux proposés (Ctrl+clic pour en choisir plusieurs)" wrapText="true"/>
                <ListView fx:id="niveauxListView" prefHeight="105.0" maxWidth="Infinity"/>
                <Button text="Ajouter la filière" onAction="#onAjouterFiliereClick" maxWidth="Infinity"/>
                <Label text="Matières de la filière sélectionnée" styleClass="subtitle-label"/>
                <HBox spacing="8.0">
                  <children>
                    <ComboBox fx:id="matiereRattacherComboBox" promptText="Matière du catalogue"
                                                                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button text="Rattacher" onAction="#onRattacherMatiereClick"/>
                  </children>
                </HBox>
                <Button text="Détacher la matière sélectionnée" onAction="#onDetacherMatiereClick"
                                                        maxWidth="Infinity" />
                <Button text="Supprimer l'UFR / la filière sélectionnée"
                                                        onAction="#onSupprimerSelectionClick" styleClass="lien-button" />
              </children>
            </VBox>
          </HBox>
        </Tab>
        <!-- Onglet 2 : catalogue des matières -->
        <Tab text="Catalogue des matières" closable="false">
          <VBox spacing="10.0">
            <padding>
              <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <TableView fx:id="matiereTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colMatiereNom" text="Nom" prefWidth="320.0"/>
              </columns>
            </TableView>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
              <children>
                <TextField fx:id="matiereNomField" promptText="Nom de la nouvelle matière"
                                                           prefWidth="300.0" HBox.hgrow="ALWAYS" />
                <Button text="Ajouter" onAction="#onAjouterMatiereClick"/>
                <Button text="Supprimer" onAction="#onSupprimerMatiereClick" styleClass="lien-button"/>
              </children>
            </HBox>
            <Label text="Pense à rattacher chaque nouvelle matière à une filière (onglet Organisation), sinon elle ne sera visible nulle part."
                                           wrapText="true" />
          </VBox>
        </Tab>
        <!-- Onglet 3 : niveaux -->
        <Tab text="Niveaux" closable="false">
          <VBox spacing="10.0">
            <padding>
              <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <TableView fx:id="niveauTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colNiveauLibelle" text="Libellé" prefWidth="320.0"/>
              </columns>
            </TableView>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
              <children>
                <TextField fx:id="niveauLibelleField" promptText="Libellé (ex: Licence 3)"
                                                           prefWidth="300.0" HBox.hgrow="ALWAYS" />
                <Button text="Ajouter" onAction="#onAjouterNiveauClick"/>
                <Button text="Supprimer" onAction="#onSupprimerNiveauClick" styleClass="lien-button"/>
              </children>
            </HBox>
          </VBox>
        </Tab>
      </TabPane>
      <HBox spacing="10.0">
        <children>
          <Button fx:id="retourButton" visible="false" managed="false" text="Retour"
                                      onAction="#onRetourClick" styleClass="lien-button" />
        </children>
      </HBox>
      <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>
    </VBox>
  </content>
</ScrollPane>
