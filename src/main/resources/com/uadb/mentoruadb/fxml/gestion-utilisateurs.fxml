<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uadb.mentoruadb.controller.GestionUtilisateursController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="Gestion des utilisateurs" styleClass="title-label" />

    <TableView fx:id="utilisateursTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="120.0" />
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120.0" />
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0" />
            <TableColumn fx:id="colRole" text="Rôle" prefWidth="90.0" />
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="90.0" />
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Activer" onAction="#onActiverClick" />
        <Button text="Désactiver" onAction="#onDesactiverClick" styleClass="lien-button" />
        <Button text="Supprimer" onAction="#onSupprimerClick" styleClass="lien-button" />
        <Button fx:id="retourButton" text="Retour" onAction="#onRetourClick" styleClass="lien-button" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>