<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="login-fond"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.uadb.mentoruadb.controller.InscriptionController">
  <children>
    <Region styleClass="login-voile"/>
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="login-scroll">
      <VBox alignment="CENTER" spacing="18.0">
        <padding>
          <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>
        <!-- En-tête UADB -->
        <HBox alignment="CENTER" spacing="12.0">
          <StackPane styleClass="login-logo-cercle" maxWidth="58.0" maxHeight="58.0">
            <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
              <Image url="@../images/logo-uadb.png"/>
            </ImageView>
          </StackPane>
          <VBox spacing="1.0" alignment="CENTER_LEFT">
            <Label text="UADB" styleClass="login-entete-titre"/>
            <Label text="Université Alioune Diop de Bambey" styleClass="login-entete-sous"/>
          </VBox>
        </HBox>
        <!-- Carte -->
        <VBox alignment="CENTER_LEFT" spacing="8.0" prefWidth="520.0" minWidth="520.0" maxWidth="520.0"
                          styleClass="login-carte">
          <padding>
            <Insets top="26.0" right="28.0" bottom="22.0" left="28.0"/>
          </padding>
          <Label text="Créer un compte étudiant" styleClass="login-carte-titre"/>
          <Label text="Renseigne tes informations pour rejoindre MentorUADB" styleClass="login-aide"/>
          <Region prefHeight="4.0"/>
          <HBox spacing="10.0">
            <TextField fx:id="nomField" promptText="Nom" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <TextField fx:id="prenomField" promptText="Prénom" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
          </HBox>
          <TextField fx:id="emailField" promptText="Email institutionnel (@uadb.edu.sn)" maxWidth="Infinity"/>
          <HBox spacing="10.0">
            <TextField fx:id="telephoneField" promptText="Téléphone" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <TextField fx:id="numeroCarteField" promptText="Numéro de carte d'étudiant" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
          </HBox>
          <TextField fx:id="emailRecuperationField" promptText="Email de récupération (Gmail, facultatif)" maxWidth="Infinity"/>
          <StackPane maxWidth="Infinity">
            <PasswordField fx:id="motDePasseField" promptText="Mot de passe" maxWidth="Infinity"
                                               style="-fx-padding: 8 42 8 10;" />
            <TextField fx:id="motDePasseVisibleField" promptText="Mot de passe" maxWidth="Infinity"
                                           style="-fx-padding: 8 42 8 10;" visible="false" managed="false" />
            <Button fx:id="toggleMotDePasseButton" text="👁" onAction="#onToggleMotDePasseClick"
                                        styleClass="toggle-password-button" StackPane.alignment="CENTER_RIGHT" />
          </StackPane>
          <ComboBox fx:id="ufrComboBox" promptText="UFR / Institut" maxWidth="Infinity"/>
          <HBox spacing="10.0">
            <ComboBox fx:id="filiereComboBox" promptText="Filière" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <ComboBox fx:id="niveauComboBox" promptText="Niveau" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
          </HBox>
          <Region prefHeight="6.0"/>
          <Button text="S'inscrire →" onAction="#onInscriptionClick" styleClass="login-bouton-principal" maxWidth="Infinity"/>
          <HBox alignment="CENTER" spacing="2.0">
            <Label text="Vous avez déjà un compte ?" styleClass="login-aide"/>
            <Button fx:id="retourButton" text="Se connecter" onAction="#onRetourConnexionClick" styleClass="lien-discret"/>
          </HBox>
          <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>
        </VBox>
      </VBox>
    </ScrollPane>
  </children>
</StackPane>
