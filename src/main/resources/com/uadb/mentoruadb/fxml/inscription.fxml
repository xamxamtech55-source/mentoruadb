<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="acc-auth-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.InscriptionController">
  <content>
    <VBox alignment="TOP_CENTER" styleClass="acc-auth-page">
      <padding>
        <Insets top="28.0" right="24.0" bottom="28.0" left="24.0"/>
      </padding>
      <children>
        <VBox spacing="16.0" maxWidth="620.0">
          <children>
            <!-- En-tête -->
            <VBox alignment="CENTER" spacing="6.0" maxWidth="Infinity">
              <children>
                <ImageView fitHeight="72.0" preserveRatio="true">
                  <image>
                    <Image url="@../images/logo-uadb.png"/>
                  </image>
                </ImageView>
                <Label text="Créer un compte étudiant" styleClass="acc-titre-form"/>
                <Label text="Rejoins la communauté de mentorat de l'Université Alioune Diop de Bambey."
                       wrapText="true" textAlignment="CENTER" maxWidth="Infinity" styleClass="acc-texte-gris"/>
              </children>
            </VBox>

            <!-- 1. Informations personnelles -->
            <VBox spacing="10.0" maxWidth="Infinity" styleClass="ds-card">
              <children>
                <Label text="1. Informations personnelles" styleClass="ds-section-title"/>
                <HBox spacing="12.0" maxWidth="Infinity">
                  <children>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label text="Nom" styleClass="acc-libelle"/>
                        <TextField fx:id="nomField" promptText="Nom" maxWidth="Infinity" styleClass="acc-champ"/>
                      </children>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label text="Prénom" styleClass="acc-libelle"/>
                        <TextField fx:id="prenomField" promptText="Prénom" maxWidth="Infinity" styleClass="acc-champ"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>

            <!-- 2. Coordonnées -->
            <VBox spacing="10.0" maxWidth="Infinity" styleClass="ds-card">
              <children>
                <Label text="2. Coordonnées" styleClass="ds-section-title"/>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="Email institutionnel" styleClass="acc-libelle"/>
                    <TextField fx:id="emailField" promptText="prenom.nom@uadb.edu.sn" maxWidth="Infinity"
                               styleClass="acc-champ"/>
                  </children>
                </VBox>
                <HBox spacing="12.0" maxWidth="Infinity">
                  <children>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label text="Téléphone" styleClass="acc-libelle"/>
                        <TextField fx:id="telephoneField" promptText="Téléphone" maxWidth="Infinity"
                                   styleClass="acc-champ"/>
                      </children>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                      <children>
                        <Label text="Email de récupération (facultatif)" styleClass="acc-libelle"/>
                        <TextField fx:id="emailRecuperationField" promptText="Gmail de récupération" maxWidth="Infinity"
                                   styleClass="acc-champ"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>

            <!-- 3. Informations universitaires -->
            <VBox spacing="10.0" maxWidth="Infinity" styleClass="ds-card">
              <children>
                <Label text="3. Informations universitaires" styleClass="ds-section-title"/>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="Numéro de carte d'étudiant" styleClass="acc-libelle"/>
                    <TextField fx:id="numeroCarteField" promptText="Numéro de carte d'étudiant" maxWidth="Infinity"
                               styleClass="acc-champ"/>
                  </children>
                </VBox>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="UFR / Institut" styleClass="acc-libelle"/>
                    <ComboBox fx:id="ufrComboBox" promptText="Choisir une UFR / Institut" maxWidth="Infinity"
                              styleClass="acc-champ"/>
                  </children>
                </VBox>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="Filière" styleClass="acc-libelle"/>
                    <ComboBox fx:id="filiereComboBox" promptText="Choisir une filière" maxWidth="Infinity"
                              styleClass="acc-champ"/>
                  </children>
                </VBox>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="Niveau" styleClass="acc-libelle"/>
                    <ComboBox fx:id="niveauComboBox" promptText="Choisir un niveau" maxWidth="Infinity"
                              styleClass="acc-champ"/>
                  </children>
                </VBox>
              </children>
            </VBox>

            <!-- 4. Informations de sécurité -->
            <VBox spacing="10.0" maxWidth="Infinity" styleClass="ds-card">
              <children>
                <Label text="4. Informations de sécurité" styleClass="ds-section-title"/>
                <VBox spacing="4.0" maxWidth="Infinity">
                  <children>
                    <Label text="Mot de passe" styleClass="acc-libelle"/>
                    <StackPane maxWidth="Infinity">
                      <children>
                        <PasswordField fx:id="motDePasseField" promptText="Mot de passe" maxWidth="Infinity"
                                       styleClass="acc-champ" style="-fx-padding: 10 42 10 12;"/>
                        <TextField fx:id="motDePasseVisibleField" promptText="Mot de passe" maxWidth="Infinity"
                                   styleClass="acc-champ" style="-fx-padding: 10 42 10 12;"
                                   visible="false" managed="false"/>
                        <Button fx:id="toggleMotDePasseButton" text="👁" onAction="#onToggleMotDePasseClick"
                                styleClass="acc-oeil" StackPane.alignment="CENTER_RIGHT">
                          <StackPane.margin>
                            <Insets right="6.0"/>
                          </StackPane.margin>
                        </Button>
                      </children>
                    </StackPane>
                  </children>
                </VBox>
              </children>
            </VBox>

            <!-- Actions -->
            <Button text="S'inscrire" onAction="#onInscriptionClick" maxWidth="Infinity"
                    styleClass="acc-bouton-principal"/>
            <Button fx:id="retourButton" text="J'ai déjà un compte — se connecter" onAction="#onRetourConnexionClick"
                    styleClass="acc-lien"/>
            <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" styleClass="message-label"/>
            <Region prefHeight="4.0"/>
          </children>
        </VBox>
      </children>
    </VBox>
  </content>
</ScrollPane>
