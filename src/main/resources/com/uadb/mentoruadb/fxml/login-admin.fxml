<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Espace de connexion réservé aux administrateurs.
  Même composition que login.fxml (hero panoramique + carte flottante) mais
  formulaire réduit à l'email et au mot de passe : un administrateur n'a pas
  de numéro de carte d'étudiant. Les comptes ETUDIANT et MENTOR sont refusés
  par LoginAdminController / AuthService.connecterAdministrateur.
-->
<ScrollPane fx:id="scrollRacine" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="acc-hero-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.LoginAdminController">
  <content>
    <StackPane fx:id="racine" styleClass="acc-login-racine" minHeight="560.0">
      <children>
        <Region styleClass="acc-hero-fond"/>
        <Region styleClass="acc-voile-hero"/>
        <HBox alignment="CENTER_LEFT" spacing="0.0" HBox.hgrow="ALWAYS">
          <padding>
            <Insets top="36.0" right="56.0" bottom="36.0" left="56.0"/>
          </padding>
          <children>
            <!-- Bloc institutionnel : masqué en fenêtre étroite -->
            <VBox fx:id="blocInstitutionnel" spacing="14.0" alignment="CENTER_LEFT"
                                 HBox.hgrow="ALWAYS" maxWidth="520.0">
              <children>
                <StackPane styleClass="acc-logo-cercle" prefWidth="84.0" prefHeight="84.0"
                                               maxWidth="84.0" maxHeight="84.0">
                  <children>
                    <ImageView fitHeight="84.0" fitWidth="84.0" preserveRatio="true">
                      <image>
                        <Image url="@../images/logo-uadb.png"/>
                      </image>
                    </ImageView>
                  </children>
                </StackPane>
                <Label text="MentorUADB" styleClass="acc-hero-marque"/>
                <Label text="Espace d'administration" wrapText="true" styleClass="acc-hero-titre"/>
                <Label text="Pilotez la plateforme de mentorat : validation des mentors, catalogue et gestion des comptes."
                                       wrapText="true" styleClass="acc-hero-texte"/>
                <Region prefHeight="10.0"/>
                <Label text="« L'excellence est ma constance, l'éthique ma vertu »"
                                       wrapText="true" styleClass="acc-citation-bas"/>
                <Label text="Devise de l'Université Alioune Diop de Bambey"
                                       wrapText="true" styleClass="acc-logo-sous"/>
                <Region prefHeight="6.0"/>
                <Label text="Accès réservé aux administrateurs" styleClass="acc-pilule-sombre"
                                       maxWidth="Infinity" alignment="CENTER"/>
              </children>
            </VBox>
            <!-- Zone droite : carte de connexion centrée -->
            <VBox fx:id="zoneCarte" HBox.hgrow="ALWAYS" alignment="CENTER">
              <children>
                <StackPane>
                  <padding>
                    <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
                  </padding>
                  <children>
                    <VBox fx:id="carteConnexion" alignment="CENTER_LEFT" spacing="8.0"
                                               maxWidth="420.0" prefWidth="400.0"
                                               styleClass="acc-carte-flottante">
                      <children>
                        <Label text="Accès administrateur" wrapText="true"
                                                       styleClass="acc-titre-form" />
                        <Label text="Connectez-vous avec votre compte administrateur UADB."
                                                       wrapText="true" styleClass="acc-texte-gris" />
                        <Region prefHeight="8.0"/>
                        <Label text="Identifiant" styleClass="acc-libelle"/>
                        <TextField fx:id="emailField" promptText="Email professionnel"
                                                              maxWidth="Infinity" styleClass="acc-champ" />
                        <Region prefHeight="4.0"/>
                        <Label text="Mot de passe" styleClass="acc-libelle"/>
                        <StackPane maxWidth="Infinity">
                          <children>
                            <PasswordField fx:id="motDePasseField" promptText="Votre mot de passe"
                                                                              maxWidth="Infinity" styleClass="acc-champ"
                                                                              style="-fx-padding: 10 42 10 12;" />
                            <TextField fx:id="motDePasseVisibleField" promptText="Votre mot de passe"
                                                                             maxWidth="Infinity" styleClass="acc-champ"
                                                                             style="-fx-padding: 10 42 10 12;" visible="false" managed="false" />
                            <Button fx:id="toggleMotDePasseButton" text="👁" onAction="#onToggleMotDePasseClick"
                                                                            styleClass="acc-oeil" StackPane.alignment="CENTER_RIGHT">
                              <StackPane.margin>
                                <Insets right="6.0"/>
                              </StackPane.margin>
                            </Button>
                          </children>
                        </StackPane>
                        <Region prefHeight="10.0"/>
                        <Button fx:id="connexionButton" text="Se connecter" maxWidth="Infinity"
                                                                onAction="#onConnexionClick" styleClass="acc-bouton-principal" />
                        <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" styleClass="acc-message"/>
                        <HBox alignment="CENTER" spacing="4.0" maxWidth="Infinity">
                          <children>
                            <Button fx:id="retourButton" text="← Retour à l'espace étudiant"
                                    onAction="#onRetourClick" styleClass="acc-lien" />
                          </children>
                        </HBox>
                        <Region prefHeight="8.0"/>
                        <Label text="Université Alioune Diop de Bambey" styleClass="acc-pied"
                                                               maxWidth="Infinity" alignment="CENTER" wrapText="true" />
                      </children>
                    </VBox>
                  </children>
                </StackPane>
              </children>
            </VBox>
          </children>
        </HBox>
      </children>
    </StackPane>
  </content>
</ScrollPane>
