<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" styleClass="login-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uadb.mentoruadb.controller.MotDePasseOublieController">
    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
    </padding>

    <Label text="Mot de passe oublié" styleClass="title-label" />
    <Label text="Renseigne ton email institutionnel et ton numéro de carte d'étudiant : un code de réinitialisation te sera envoyé par mail" wrapText="true" />

    <TextField fx:id="emailField" promptText="Email institutionnel" prefWidth="280.0" maxWidth="280.0" />
    <TextField fx:id="numeroCarteField" promptText="Numéro de carte d'étudiant" prefWidth="280.0" maxWidth="280.0" />

    <Button fx:id="envoyerCodeButton" text="Envoyer le code" onAction="#onEnvoyerCodeClick" prefWidth="280.0" maxWidth="280.0" />
    <Button fx:id="retourButton" text="Retour à la connexion" onAction="#onRetourClick" styleClass="lien-button" prefWidth="280.0" maxWidth="280.0" />

    <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />
</VBox>
