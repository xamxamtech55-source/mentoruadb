<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="acc-auth-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.MotDePasseOublieController">
  <content>
    <VBox alignment="CENTER" styleClass="acc-auth-page">
      <padding>
        <Insets top="28.0" right="24.0" bottom="28.0" left="24.0"/>
      </padding>
      <children>
        <VBox alignment="CENTER_LEFT" spacing="8.0" maxWidth="460.0" styleClass="acc-auth-carte">
          <padding>
            <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
          </padding>
          <children>
            <!-- En-tête : logo à gauche, retour à la connexion à droite -->
            <StackPane maxWidth="Infinity">
              <children>
                <StackPane styleClass="acc-auth-logo" prefWidth="72.0" prefHeight="72.0"
                           maxWidth="72.0" maxHeight="72.0" StackPane.alignment="CENTER_LEFT">
                  <children>
                    <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                      <image>
                        <Image url="@../images/logo-uadb.png"/>
                      </image>
                    </ImageView>
                  </children>
                </StackPane>
                <Button fx:id="retourButton" text="← Retour à la connexion" onAction="#onRetourClick"
                        styleClass="acc-lien" StackPane.alignment="TOP_RIGHT"/>
              </children>
            </StackPane>
            <Label text="Mot de passe oublié" wrapText="true" styleClass="acc-titre-form"/>
            <Label text="Renseigne ton email institutionnel, ton numéro de carte d'étudiant, puis l'adresse qui recevra le code de réinitialisation (n'importe quel Gmail ou autre)."
                   wrapText="true" maxWidth="Infinity" styleClass="acc-texte-gris"/>
            <Region prefHeight="6.0"/>
            <Label text="Email institutionnel" styleClass="acc-libelle"/>
            <TextField fx:id="emailField" promptText="prenom.nom@uadb.edu.sn" maxWidth="Infinity"
                       styleClass="acc-champ"/>
            <Label text="Numéro de carte d'étudiant" styleClass="acc-libelle"/>
            <TextField fx:id="numeroCarteField" promptText="Numéro de carte d'étudiant" maxWidth="Infinity"
                       styleClass="acc-champ"/>
            <Label text="Adresse de réception du code" styleClass="acc-libelle"/>
            <TextField fx:id="emailRecuperationField" promptText="Gmail de réception du code" maxWidth="Infinity"
                       styleClass="acc-champ"/>
            <Region prefHeight="6.0"/>
            <Button fx:id="envoyerCodeButton" text="Envoyer le code" onAction="#onEnvoyerCodeClick"
                    maxWidth="Infinity" styleClass="acc-bouton-principal"/>
            <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" styleClass="message-label"/>
          </children>
        </VBox>
      </children>
    </VBox>
  </content>
</ScrollPane>
