<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.ProfilController">
    <VBox styleClass="contenu-page">
        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

        <VBox spacing="12.0" styleClass="page-carte">
            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0" /></padding>

            <!-- Page intégrée au tableau de bord : le retour se fait par la barre latérale -->
            <Button fx:id="retourButton" visible="false" managed="false" text="Retour" onAction="#onRetourClick" />

            <Label text="Mon profil" styleClass="title-label" />

            <Label fx:id="emailLabel" />
            <TextField fx:id="telephoneField" promptText="Téléphone" maxWidth="300.0" />
            <TextField fx:id="emailRecuperationField" promptText="Email de récupération (Gmail, ...)" maxWidth="300.0" />
            <Label text="Cet email personnel reçoit le code de réinitialisation du mot de passe" wrapText="true" />

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Choisir une photo..." onAction="#onChoisirPhotoClick" />
                <Label fx:id="photoLabel" text="Aucune photo" />
            </HBox>

            <TextField fx:id="numeroCarteField" promptText="Numéro de carte d'étudiant" maxWidth="300.0" />

            <Label fx:id="statutCandidatureLabel" styleClass="statut-candidature-label" wrapText="true"
                visible="false" managed="false" />

            <Separator fx:id="separateurMentor" />
            <Label fx:id="titreMentorLabel" text="Profil mentor" styleClass="subtitle-label" />

            <TextArea fx:id="biographieField" promptText="Biographie" prefRowCount="3" wrapText="true" />
            <TextField fx:id="experienceField" promptText="Expérience (ex: 2 ans de tutorat)" maxWidth="300.0" />
            <ComboBox fx:id="modePreferenceComboBox" promptText="Mode de préférence" maxWidth="300.0" />
            <TextField fx:id="nombreMaxMentoresField" promptText="Nombre max de mentorés" maxWidth="300.0" />

            <HBox spacing="10.0">
                <Button text="Enregistrer" onAction="#onEnregistrerClick" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />
        </VBox>
    </VBox>
</ScrollPane>