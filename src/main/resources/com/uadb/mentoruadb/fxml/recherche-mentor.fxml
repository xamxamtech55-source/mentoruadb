<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.RechercheMentorController">
  <VBox styleClass="contenu-page">
    <padding>
      <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>
    <VBox spacing="12.0" styleClass="page-carte">
      <padding>
        <Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/>
      </padding>
      <!-- Page intégrée au tableau de bord : le retour se fait par la barre latérale -->
      <Button fx:id="retourButton" visible="false" managed="false" text="Retour" onAction="#onRetourClick"/>
      <Label text="Rechercher un mentor" styleClass="title-label"/>
      <Label text="Mentors suggérés pour ta filière" styleClass="subtitle-label"/>
      <TableView fx:id="suggestionsTable" prefHeight="150.0" maxHeight="170.0">
        <columns>
          <TableColumn fx:id="colSuggNom" text="Mentor" prefWidth="150.0"/>
          <TableColumn fx:id="colSuggNiveau" text="Niveau" prefWidth="90.0"/>
          <TableColumn fx:id="colSuggMatieres" text="Matières" prefWidth="250.0"/>
          <TableColumn fx:id="colSuggNote" text="Note" prefWidth="110.0"/>
        </columns>
      </TableView>
      <Label text="Ou recherche par matière : UFR → filière → matière" styleClass="subtitle-label"/>
      <HBox spacing="15.0">
        <VBox spacing="6.0" prefWidth="320.0" minWidth="320.0">
          <Label text="Clique sur une matière pour lister ses mentors" wrapText="true"/>
          <TreeView fx:id="matiereTree" prefHeight="230.0"/>
        </VBox>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
          <Label fx:id="matiereChoisieLabel" text="Aucune matière sélectionnée"/>
          <TableView fx:id="mentorsTable" prefHeight="230.0">
            <columns>
              <TableColumn fx:id="colMentorNom" text="Mentor" prefWidth="170.0"/>
              <TableColumn fx:id="colMentorFiliere" text="Filière" prefWidth="140.0"/>
              <TableColumn fx:id="colMentorNiveau" text="Niveau" prefWidth="90.0"/>
            </columns>
          </TableView>
        </VBox>
      </HBox>
      <HBox spacing="15.0" alignment="CENTER_LEFT">
        <StackPane styleClass="photo-frame" maxWidth="100.0" maxHeight="100.0" minWidth="100.0" minHeight="100.0">
          <ImageView fx:id="photoMentorImageView" fitWidth="100.0" fitHeight="100.0" preserveRatio="true"/>
        </StackPane>
        <TextArea fx:id="profilTextArea" editable="false" wrapText="true" prefRowCount="5" HBox.hgrow="ALWAYS"
                            promptText="Sélectionne un mentor (suggéré ou trouvé par recherche) puis clique sur « Voir le profil »" />
      </HBox>
      <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Voir le profil" onAction="#onVoirProfilClick"/>
        <Button text="Envoyer une demande" onAction="#onDemanderClick"/>
      </HBox>
      <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>
    </VBox>
  </VBox>
</ScrollPane>
