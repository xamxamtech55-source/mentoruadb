<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.RechercheMentorController" styleClass="acc-auth-scroll">
    <HBox alignment="CENTER">
        <VBox spacing="12.0" prefWidth="880.0" maxWidth="880.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>

            <Label text="Rechercher un mentor" styleClass="title-label" />
            <Label text="Trouve un mentor validé par UFR, filière, niveau et matière." styleClass="subtitle-label" wrapText="true" />

            <!-- Filtres -->
            <VBox styleClass="ds-card" spacing="10.0">
                <Label text="Filtres de recherche" styleClass="ds-section-title" />
                <HBox spacing="10.0">
                    <ComboBox fx:id="ufrComboBox" promptText="UFR" prefWidth="210.0" />
                    <ComboBox fx:id="filiereComboBox" promptText="Filière" prefWidth="210.0" />
                    <ComboBox fx:id="niveauComboBox" promptText="Niveau" prefWidth="150.0" />
                    <ComboBox fx:id="matiereComboBox" promptText="Matière" prefWidth="210.0" />
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button fx:id="rechercherButton" text="Rechercher" onAction="#onRechercherClick" styleClass="ds-btn" />
                    <Button text="Réinitialiser" onAction="#onReinitialiserClick" styleClass="ds-btn,ds-btn-secondary" />
                    <ProgressIndicator fx:id="rechercheProgress" visible="false" managed="false"
                                       prefWidth="22.0" prefHeight="22.0" />
                </HBox>
                <Label text="Un filtre vide élargit la recherche. Les matières proposées suivent la filière choisie."
                       styleClass="ds-help" wrapText="true" />
            </VBox>

            <!-- Suggestions -->
            <Label text="Mentors suggérés pour ta filière" styleClass="subtitle-label" />
            <TableView fx:id="suggestionsTable" prefHeight="140.0" maxHeight="160.0">
                <columns>
                    <TableColumn fx:id="colSuggNom" text="Mentor" prefWidth="150.0" />
                    <TableColumn fx:id="colSuggNiveau" text="Niveau" prefWidth="90.0" />
                    <TableColumn fx:id="colSuggMatieres" text="Matières" prefWidth="250.0" />
                    <TableColumn fx:id="colSuggNote" text="Note" prefWidth="110.0" />
                </columns>
            </TableView>

            <!-- Résultats -->
            <Label text="Résultats" styleClass="subtitle-label" />
            <Label fx:id="resultatsVideLabel" text="Lance une recherche pour afficher des mentors."
                   styleClass="ds-empty" wrapText="true" />
            <TableView fx:id="mentorsTable" prefHeight="180.0" maxHeight="220.0" visible="false" managed="false">
                <columns>
                    <TableColumn fx:id="colMentorNom" text="Mentor" prefWidth="150.0" />
                    <TableColumn fx:id="colMentorFiliere" text="Filière" prefWidth="140.0" />
                    <TableColumn fx:id="colMentorNiveau" text="Niveau" prefWidth="90.0" />
                    <TableColumn fx:id="colMentorMatieres" text="Matières" prefWidth="200.0" />
                    <TableColumn fx:id="colMentorNote" text="Note" prefWidth="80.0" />
                    <TableColumn fx:id="colMentorDispo" text="Disponibilité" prefWidth="180.0" />
                </columns>
            </TableView>

            <!-- Profil du mentor sélectionné -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <StackPane styleClass="photo-frame" maxWidth="100.0" maxHeight="100.0" minWidth="100.0" minHeight="100.0">
                    <ImageView fx:id="photoMentorImageView" fitWidth="100.0" fitHeight="100.0" preserveRatio="true" />
                </StackPane>
                <TextArea fx:id="profilTextArea" editable="false" wrapText="true" prefRowCount="5" HBox.hgrow="ALWAYS"
                          promptText="Sélectionne un mentor (suggéré ou dans les résultats) puis clique sur « Voir le profil »" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Voir le profil" onAction="#onVoirProfilClick" styleClass="ds-btn,ds-btn-secondary" />
                <Button fx:id="envoyerDemandeButton" text="Envoyer une demande" onAction="#onDemanderClick" styleClass="ds-btn" />
                <Button fx:id="retourButton" text="Retour au tableau de bord" onAction="#onRetourClick" styleClass="ds-btn,ds-btn-ghost" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />
        </VBox>
    </HBox>
</ScrollPane>
