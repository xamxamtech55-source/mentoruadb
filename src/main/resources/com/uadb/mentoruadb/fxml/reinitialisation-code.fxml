<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="acc-auth-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.ReinitialisationCodeController">
  <content>
    <VBox alignment="CENTER" styleClass="acc-auth-page">
      <padding>
        <Insets top="28.0" right="24.0" bottom="28.0" left="24.0"/>
      </padding>
      <children>
        <VBox alignment="CENTER_LEFT" spacing="8.0" maxWidth="460.0" styleClass="acc-auth-carte">
          <padding>
            <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
          </padding>
          <children>
            <!-- En-tête : logo à gauche, retour à la connexion à droite -->
            <StackPane maxWidth="Infinity">
              <children>
                <StackPane styleClass="acc-auth-logo" prefWidth="72.0" prefHeight="72.0"
                           maxWidth="72.0" maxHeight="72.0" StackPane.alignment="CENTER_LEFT">
                  <children>
                    <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                      <image>
                        <Image url="@../images/logo-uadb.png"/>
                      </image>
                    </ImageView>
                  </children>
                </StackPane>
                <Button fx:id="retourButton" text="← Retour à la connexion" onAction="#onRetourClick"
                        styleClass="acc-lien" StackPane.alignment="TOP_RIGHT"/>
              </children>
            </StackPane>
            <Label text="Réinitialisation du mot de passe" wrapText="true" styleClass="acc-titre-form"/>
            <Label fx:id="emailEnvoyeLabel" text="Code envoyé" wrapText="true" maxWidth="Infinity"
                   styleClass="acc-texte-gris"/>
            <Label text="Saisis le code à 6 chiffres reçu à ton adresse de récupération, puis choisis un nouveau mot de passe."
                   wrapText="true" maxWidth="Infinity" styleClass="acc-texte-gris"/>
            <Region prefHeight="6.0"/>
            <Label text="Code de vérification" styleClass="acc-libelle"/>
            <TextField fx:id="codeField" promptText="Code à 6 chiffres" maxWidth="Infinity"
                       styleClass="acc-champ"/>
            <Label text="Nouveau mot de passe" styleClass="acc-libelle"/>
            <PasswordField fx:id="nouveauMotDePasseField" promptText="Nouveau mot de passe" maxWidth="Infinity"
                           styleClass="acc-champ"/>
            <Label text="Confirmer le mot de passe" styleClass="acc-libelle"/>
            <PasswordField fx:id="confirmationField" promptText="Confirmer le mot de passe" maxWidth="Infinity"
                           styleClass="acc-champ"/>
            <Region prefHeight="6.0"/>
            <Button text="Réinitialiser le mot de passe" onAction="#onVerifierClick"
                    maxWidth="Infinity" styleClass="acc-bouton-principal"/>
            <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" styleClass="message-label"/>
          </children>
        </VBox>
      </children>
    </VBox>
  </content>
</ScrollPane>
