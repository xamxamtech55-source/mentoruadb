<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uadb.mentoruadb.controller.SeanceGroupeController">
    <VBox styleClass="contenu-page">
        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>

        <VBox spacing="12.0" styleClass="page-carte">
            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0" /></padding>

            <!-- Page intégrée au tableau de bord : le retour se fait par la barre latérale -->
            <Button fx:id="retourButton" visible="false" managed="false" text="Retour" onAction="#onRetourClick" />

            <Label text="Créer une séance de groupe" styleClass="title-label" />
            <Label text="Tous les étudiants ayant une demande acceptée avec toi sur la matière choisie seront invités automatiquement." wrapText="true" />

            <ComboBox fx:id="matiereComboBox" promptText="Matière" maxWidth="Infinity" />
            <DatePicker fx:id="dateSeancePicker" promptText="Date" maxWidth="Infinity" />

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="heureDebutField" promptText="Début (HH:mm)" prefWidth="100.0" />
                <TextField fx:id="heureFinField" promptText="Fin (HH:mm)" prefWidth="100.0" />
                <ComboBox fx:id="modaliteComboBox" promptText="Modalité" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

            <TextField fx:id="lieuField" promptText="Salle ou lien (visio)" maxWidth="Infinity" />

            <HBox spacing="10.0">
                <Button text="Créer la séance" onAction="#onCreerClick" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" />
        </VBox>
    </VBox>
</ScrollPane>